{
  "expo": {
    "name": "BOAROUTE",
    "slug": "BOAROUTE",
    "scheme": "boaroute",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#060606",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boanets.boaroute"
    },
    "android": {
      "package": "com.boanets.boaroute",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-image",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#060606"
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#CDA960",
          "defaultChannel": "reminders",
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/sounds/clock_out.wav",
            "./assets/sounds/clock_out_alarm.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BOAROUTE needs your photos so you can attach pictures and videos to store tasks.",
          "cameraPermission": "BOAROUTE uses the camera so you can photograph displays for your store tasks.",
          "microphonePermission": "BOAROUTE records sound when you film a video for a store task."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "# WorkManager (pulled in by react-native-maps) starts at launch and creates its\n# Room database and input mergers by reflection, so R8 must keep their constructors.\n-keep class * extends androidx.room.RoomDatabase { void <init>(); }\n-keep class * extends androidx.work.InputMerger { void <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class * extends androidx.work.ListenableWorker { <init>(android.content.Context, androidx.work.WorkerParameters); }"
          }
        }
      ],
      [
        "react-native-car-projection",
        {
          "carAppCategory": "navigation",
          "minCarApiLevel": 1,
          "targetCarApiLevel": 6,
          "mediaSupport": false,
          "customPermissions": [
            "androidx.car.app.NAVIGATION_TEMPLATES"
          ]
        }
      ],
      "./plugins/withCarAppDescriptor"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5ec1405e-84fd-4d38-90d4-c802d4ac0058"
      }
    },
    "owner": "boanets-team"
  }
}
